# =============================================================================
# SMART SALON & PARLOUR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and provide your real credentials for production deploy.
# WARNING: Keep your real '.env' file private and NEVER commit it to git!
# =============================================================================

# --- 1. SERVER & APPLICATION SETTINGS ---
PORT=3000
NODE_ENV=production
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- 2. MYSQL PRODUCTION DATABASE CONFIGURATION ---
# Connect to your production MySQL 8.0+ server (AWS RDS, Cloud SQL, Railway, cPanel, or Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=smart_salon_db

# Alternative single connection URL (supported by cloud platforms like Railway / Render):
# MYSQL_URL="mysql://root:password@localhost:3306/smart_salon_db"

# Spring Boot Java Backend Datasource (if running backend-java on port 8080):
# SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/smart_salon_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true"

# --- 3. GOOGLE OAUTH 2.0 (SIGN IN WITH GOOGLE) ---
# Create credentials at Google Cloud Console (https://console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized JavaScript Origins: https://yourdomain.com, http://localhost:3000
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# --- 4. RAZORPAY PAYMENT GATEWAY (10% ADVANCE DEPOSIT COLLECTION) ---
# Obtain from Razorpay Dashboard (https://dashboard.razorpay.com -> Settings -> API Keys)
# Use 'rzp_test_...' for staging sandbox or 'rzp_live_...' for real client payments
RAZORPAY_KEY_ID="rzp_test_modern_salon_mohol"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
VITE_RAZORPAY_KEY_ID="rzp_test_modern_salon_mohol"

# --- 5. SALON DIRECT BANK UPI (NPCI QR CODE ENGINE) ---
# Direct UPI VPA for Google Pay, PhonePe, BHIM, and Paytm QR payments
SALON_UPI_VPA="8104026257@okicici"

# --- 6. GOOGLE GEMINI AI ASSISTANT & STYLIST ---
# Get your API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# --- 7. OWNER & ADMIN SECURITY ---
# 4-Digit Quick PIN for Counter Reception & Tablet Terminals
ADMIN_PIN="9999"
